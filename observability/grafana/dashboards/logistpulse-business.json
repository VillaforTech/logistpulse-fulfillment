    {
      "id": 5,
      "type": "stat",
      "title": "Monitor independiente \u00b7 edad del c\u00e1lculo (s)",
      "description": "M\u00e9trica operativa consultada cada 5 s. Si supera 3 s o no hay datos, los \u00faltimos valores Live NO confirman salud.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - logistpulse_analytics_snapshot_timestamp_seconds",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "SIN CONEXI\u00d3N",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "SIN CONEXI\u00d3N",
                  "color": "gray",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "SIN CONEXI\u00d3N",
                  "color": "gray",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
