  "panels": [
    {
      "id": 1,
      "type": "logistpulse-business-panel",
      "title": "L-K1 \u00b7 Promesas incumplidas",
      "description": "Datasource nativo Grafana Live. El renderer del proyecto invalida esta tarjeta tras 3s sin revisi\u00f3n o con computedAt antiguo.",
      "datasource": {
        "type": "grafana",
        "uid": "grafana"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana",
            "uid": "grafana"
          },
          "queryType": "measurements",
          "channel": "stream/logistpulse/business",
          "filter": {
            "fields": [
              "lk1",
              "lk2",
              "lk3",
              "sample",
              "quality",
              "revision",
              "aggregate_id",
              "aggregate_version",
              "correlation_id",
              "source_event_id",
              "computed_at"
            ]
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "DATOS NO CONFIABLES",
                  "color": "gray",
                  "index": 0
                },
                "-2": {
                  "text": "SIN MUESTRA",
                  "color": "gray",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-06
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "field": "lk1"
      }
    },
